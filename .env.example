# BIGNET Inventory System - Production Environment Configuration Template
# Copy this file to '.env' in production environment and update values accordingly.

APP_NAME="GUDANG PT.BIG"
APP_ENV=production
APP_URL=https://inventori.bignet.id
APP_TIMEZONE=Asia/Jakarta
APP_DEBUG=false

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_gudang_bignet
DB_USERNAME=bignet_user
DB_PASSWORD=your_secure_production_password
DB_CHARSET=utf8mb4

# Web Server & Session Security
# DocumentRoot MUST be set to the '/public' directory of this application.
SESSION_SECURE_COOKIE=true
